NODE_ENV=development
PORT=5107
HOST=127.0.0.1
DATA_DIR=./data
LOG_DIR=./logs
BACKUP_DIR=./backups
STORAGE_DRIVER=sqlite
DATABASE_URL=file:./data/education.db
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_IDLE_TIMEOUT_MS=172800000
SESSION_TTL_MS=172800000
COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_COOLDOWN_MS=600000
MAX_UPLOAD_SIZE_BYTES=3221225472
AI_PDF_AGENT_TIMEOUT_MS=480000
PDF_AGENT_TIMEOUT_MS=1200000
PDF_AGENT_PYTHON=python
PDF_AGENT_OCR_MAX_PAGES=80
PDF_AGENT_OCR_LEADING_PAGES=40
PDF_AGENT_OCR_SCALE=1.6
MODEL_CODE_PYTHON=python
MODEL_CODE_TIMEOUT_MS=10000
MODEL_CODE_MAX_CHARS=80000
MODEL_CODE_MAX_OUTPUT_CHARS=30000
MODEL_CODE_REPAIR_MAX_ATTEMPTS=2
MODEL_CODE_ALLOWED_IMPORTS=math,random,statistics,collections,itertools,functools,operator,heapq,bisect,decimal,fractions,typing,dataclasses
OPENAI_API_KEY=ollama-local
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
